<div class="home-listing">
  <% if (!latest) { %><p class="home-empty">No posts published yet.</p><% } %>
  <% if (latest) { %><p class="home-category-reset"><a href="#category=">All categories</a></p><% } %>
  <div class="list">
  <% for (const entry of grouped) { const item = entry.item; %>
    <article class="home-post home-<%= entry.kind %>" <%= metadataAttrs(item) %>>
      <% if (entry.label && ['latest', 'pinned'].includes(entry.kind)) { %><span class="ggm-badge ggm-badge-<%- entry.kind %>"><%- entry.label %></span><% } %>
      <% if (entry.label && ['compact', 'staged'].includes(entry.kind)) { %><h2 class="home-group-title"><%- entry.label %></h2><% } %>
      <div class="home-post-content">
        <% if (entry.kind === 'latest' && item === pin) { %><span class="ggm-badge ggm-badge-pinned">Pinned</span><% } %>
        <% if (item['ggm-draft'] === true || item['ggm-draft'] === 'true') { %><span class="ggm-badge ggm-badge-draft">Draft</span><% } %>
        <% if (item['ggm-scheduled']) { %><span class="ggm-badge ggm-badge-scheduled">Scheduled <%- item['ggm-scheduled'] %></span><% } %>
        <h3 class="listing-title"><a href="<%- item.path %>"><%= item.title %></a></h3>
        <div class="home-post-meta">
          <span class="listing-author"><%= item.author %></span>
          <% if (item.date) { %><span class="listing-date"><%= item.date %></span><% } %>
        </div>
        <% if (item.categories && item.categories.length) { %>
        <div class="listing-categories home-categories">
          <% for (const category of item.categories) { %>
          <a class="listing-category" href="#category=<%- encodeURIComponent(category) %>"><%- category %></a>
          <% } %>
        </div>
        <% } %>
        <% if (item.description) { %><p class="listing-description"><%= preview(item.description, entry.kind === 'compact' ? 160 : 400) %></p><% } %>
      </div>
    </article>
  <% } %>
  </div>
</div>
