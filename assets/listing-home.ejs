<%
// The pre-render rank is date descending, non-featured first on ties, then title.
items.sort((a, b) => Number(a["ggm-order"]) - Number(b["ggm-order"]));
const truthy = (value) => value === true || value === 'true';
const live = items.filter((item) => truthy(item['ggm-live']));
const staged = items.filter((item) => !truthy(item['ggm-live']));
const topics = new Map();
for (const item of items) {
  for (const category of item.categories || []) topics.set(category, (topics.get(category) || 0) + 1);
}
const latest = live[0];
const isFeatured = (item) => truthy(item.featured);
const pin = live.find(isFeatured);
const pinned = pin && pin !== latest ? [pin] : [];
const remaining = live.filter((item) => item !== latest && item !== pin);
const grouped = [
  ...(latest ? [{ item: latest, kind: 'latest', label: 'Latest' }] : []),
  ...pinned.map((item) => ({ item, kind: 'pinned', label: 'Pinned' })),
  ...remaining.map((item, i) => ({ item, kind: 'compact', label: i === 0 ? 'All posts' : '' })),
  ...staged.map((item, i) => ({ item, kind: 'staged', label: i === 0 ? 'Drafts and scheduled' : '' }))
];
const preview = (description, length) => {
  const text = String(description || '');
  // Quarto 1.9 defers automatic excerpts as comments until posts are rendered.
  // Preserve that token and set its limit rather than truncating the token itself.
  if (/^<!-- desc\(/.test(text)) return text.replace(/\[max=[^\]]*\]/, `[max=${length}]`);
  const plain = text.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
  const short = plain.length > length ? plain.slice(0, length).replace(/\s+\S*$/, '') + '…' : plain;
  return short.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
};
%>
